# Copy to backend/.env or export in the shell. Paths are relative to the repository root.
DATABASE_URL=sqlite:///./infraguard.db
CORS_ORIGINS=http://localhost:5173
MODEL_ARTIFACT_PATH=ml/artifacts/ai4i/pipeline.joblib
SIMULATION_ENABLED=true
# Optional. Enables the Gemini incident agent; without it a deterministic fallback runs.
GEMINI_API_KEY=
# Optional second key, used when the first is rate limited. A key from a different Google project adds quota;
# keys from the same project share one quota.
GEMINI_API_KEY_2=
# Models tried in order; each has its own free-tier daily quota.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Live fleet demo: seconds between readings, and automatic AI investigation of new incidents.
LIVE_TICK_SECONDS=1.0
AUTO_INVESTIGATE=true
MINING_LAYOUT_PATH=configs/mining_layout.json
HASHPRICE_DATA_PATH=data/market/hashprice_daily.csv
