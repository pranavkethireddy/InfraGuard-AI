# Public, browser-visible configuration. Never put secrets in VITE_* variables.
# Live is the export default. Use fixture explicitly for offline preview; actions are disabled.
VITE_DATA_MODE=live
# VITE_DATA_MODE=fixture
# Same-origin: Vite forwards /api unchanged to the local backend.
VITE_API_BASE_URL=/api/v1
# Optional absolute API origin (must support the frontend origin and event streams):
# VITE_API_BASE_URL=https://your-api.example/api/v1
